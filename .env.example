# Copiar para .env.production e preencher com valores reais.
# NUNCA comitar o .env.production.

# --- Base de dados MySQL ---
# Em produção (docker-compose) o host é o nome do serviço: "db".
# Em desenvolvimento local usa-se "127.0.0.1" (ou omite tudo: há defaults).
DB_HOST=db
DB_PORT=3306
DB_NAME=algugest
DB_USER=algugest
DB_PASSWORD=troca-esta-senha-forte
# Password do utilizador root do MySQL (só usada pelo contentor).
DB_ROOT_PASSWORD=troca-esta-outra-senha-forte

# --- TLS da base de dados (a Aiven exige) ---
# Ativa a ligação cifrada. Com CA carregada, o certificado do servidor é validado.
DB_SSL=true
# Certificado público da Aiven (já vem no repositório em certs/aiven-ca.pem).
DB_SSL_CA_FILE=certs/aiven-ca.pem
# Alternativa: colar o certificado PEM aqui, com \n no fim de cada linha.
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...

# --- Painel /admin ---
# Só é usada uma vez, para semear o primeiro utilizador admin na base de dados.
# Depois de arrancar, a palavra-passe vive na tabela admin_users.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troca-esta-senha-por-uma-forte

# Segredo para assinar a sessão. Gera com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SECRET=troca-este-segredo-aleatorio

# URL pública do site (usada no SEO, canonical, sitemap)
NEXT_PUBLIC_SITE_URL=https://algugest.ao

# --- Cloudinary (uploads de imagens e vídeos) ---
# Sem CLOUDINARY_URL os uploads vão para public/imagens/uploads (só em local).
# Com CLOUDINARY_URL tudo vai para a cloud — obrigatório no Render.
# Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary:troca-chave:troca-segredo@troca-cloud-name
# Pasta onde os ficheiros são guardados na cloud.
CLOUDINARY_FOLDER=algugest

# --- Caddy (HTTPS) ---
# Produção (VPS): deixa o teu domínio real e CADDY_TLS vazio (Let's Encrypt).
# Ensaio local com Docker: SITE_ADDRESS=algugest.localhost e CADDY_TLS=tls internal.
SITE_ADDRESS=algugest.ao, www.algugest.ao
CADDY_TLS=
